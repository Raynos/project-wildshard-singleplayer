{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "isolatedDeclarations": true,
    "outDir": ".tsc-layers/sharddev",
    "tsBuildInfoFile": ".tsc-layers/sharddev.tsbuildinfo"
  },
  "references": [
    {
      "path": "./tsconfig.engine.json"
    },
    {
      "path": "./tsconfig.game.json"
    },
    {
      "path": "./tsconfig.sdk.json"
    }
  ],
  "include": [
    "src/sharddev/**/*.ts",
    "src/sharddev/**/*.mts",
    "src/engine/**/*.d.ts",
    "src/game/**/*.merge.d.ts"
  ],
  "exclude": [
    "src/sharddev/**/*.test.ts",
    "src/sharddev/test"
  ]
}
