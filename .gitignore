node_modules
dist
.DS_Store
.vercel
.env*
dist-native
dist-drafts
dist-site
dist-admin
.native-build
# Claude-managed nested checkout; it has its own Git state and must not be nested in this repo.
/.claude/worktrees/
# Local capture scratch and an already archived HUD mockup source (the JPEG lives in art/hud/round-7-sword-touch/).
/cap2.png
/iso-test.png
/art/touch-sword-B-lunge.png
# The reviewed JPEG references are committed; keep lossless local source copies outside Git.
/art/hud-explorer/round-3-dummy-meshes/*.png
# boot packs: regenerated by every build from the committed assets (scripts/bake-packs.mjs)
public/assets/packs/

# review inbox notes pulled by `pnpm inbox:pull` (scripts/inbox-pull.mjs)
.review/
# Rapier WASM: copied from node_modules by every build (vite/rapier.ts)
public/assets/physics/
# the Basis Universal transcoder for KTX2 textures: copied from three by every build (vite/basis.ts, E157)
public/basis/
# Python bytecode from the pipeline scripts (scripts/horizon-matte/config.py, fit-lut.py loading palette-delta.py)
__pycache__/

# Raw local benchmark runs and rendered scorecard frames stay on disk; commit selected summaries explicitly.
/progress/bench/*.json
/progress/bench/shot-*.png
/progress/texmem/*.json
/progress/scorecard/*/

# Blender: the script is the source and the exported GLB is committed; a .blend never is (M10, E315). Inspection
# copies go to ~/.cache/wildshard-blender/ (scripts/blender/build.sh --save-blend); .githooks/pre-commit refuses one.
*.blend
*.blend[0-9]*

# E357 parity harness artifacts
/progress/parity/
/coverage/

# E357 F9: build-derived tables; KTX2 tables require local basisu and stay committed.
src/**/*.generated.*
!src/**/ktx2.generated.ts

# local caches and raw capture frames (never committed)
/.cache/
/progress/e304-faces/raw/

# E389: time-lapses are rebuilt from the per-capture folders (scripts/shard-timelapse.py); only the captures are committed
/progress/*/timelapse-*.mp4
/progress/*/clips.mp4

# E362 AG4: the layered TypeScript build's declaration output (tsc -b tsconfig.layers.json)
.tsc-layers/

# Rebuilt SDK projects; source remains in src/shards.
/public/shardfiles/

# Portable author tools are rebuilt for pack.
/src/sdk/dist/

# SF74 W13 (Jake, G281): API docs and the surface are build outputs of `pnpm gen` (scripts/gen-api.mjs), never committed
/docs/api/
/lint/api-surface.json

# G292: SHA256-pinned outputs restored by pnpm gen; retained generators and provenance are in scripts/generation-jobs.json.
/public/assets/pine-hollow/baked/cabins.bin
/public/assets/nalati/baked/bodies.bin
/public/assets/far-reach/rigs/sky-goat.glb
/public/assets/far-reach/rigs/storm-roc.glb

# DS1.2: inspectable content-hash scene intermediates never ship or enter git.
**/.wildshard/

# Pine lossless coat pages are retained authoring jobs, generated behind verified build hashes (G318).
/public/assets/pine-hollow/creatures/*.coat.png
/src/shards/pine-hollow/data/coatPages.generated.json

# Retained Pine rig sources live in authoring assets; public copies are cache products.
/public/assets/pine-hollow/creatures/deer-hind.rigged.glb
/public/assets/pine-hollow/creatures/deer-hind.phone.rigged.glb
/public/assets/pine-hollow/creatures/deer-stag.rigged.glb
/public/assets/pine-hollow/creatures/deer-stag.phone.rigged.glb
/public/assets/pine-hollow/creatures/boar.rigged.glb
/public/assets/pine-hollow/creatures/boar.phone.rigged.glb
/public/assets/pine-hollow/creatures/elk-cow.rigged.glb
/public/assets/pine-hollow/creatures/elk-cow.phone.rigged.glb
/public/assets/pine-hollow/creatures/elk-bull.rigged.glb
/public/assets/pine-hollow/creatures/elk-bull.phone.rigged.glb
/public/assets/pine-hollow/creatures/bear-black.rigged.glb
/public/assets/pine-hollow/creatures/bear-black.phone.rigged.glb
/public/assets/pine-hollow/creatures/bear-brown.rigged.glb
/public/assets/pine-hollow/creatures/bear-brown.phone.rigged.glb

# SF81: retained typed night author rebuilds its 2 KB module in the shared build cache.
/src/shards/pine-hollow/assets/a99e1e49bad615716eecc55964300848fb9efc9aab3beeeeaee01adffa243cda

# SF81: retained Nalati raid author, portable content-hash build outputs.
/src/shards/nalati-grasslands/behaviour/director.generated.json
/src/shards/nalati-grasslands/assets/077258690108c4ffde5eb0c46105e323ff854070323da971c08586751e427646

# SF81: retained ghost volley author; portable cached outputs.
/src/shards/nalati-grasslands/assets/3e6bce711c85df2ed170797d6d5ac606e89436e21d7865b07bc91f13d7912de1
/src/shards/nalati-grasslands/behaviour/ghostVolley.generated.json

# Retained Rising Islet authoring; regenerated through the verified content-hash cache.
/src/shards/far-reach/data/islets.generated.json

# G331: local tool state, logs and temporary merge files are not source.
*.tsbuildinfo
/*.log
/.merge_file_*
/boot-smoke-results/
/scratchpad/

# G331: raw proof runs and expanded memory dumps stay local; commit summaries.
/progress/**/*.jsonl
/progress/**/*.phase
/progress/**/*.vmmap.txt
/progress/**/*.heap.json
/progress/**/*.heap-analysis.json
/progress/**/*.heap-owners.json
/progress/**/*.log
/progress/**/*.gz
/progress/**/*.br
/progress/**/*.zst
/progress/frame-floor/*-*-*.json
/progress/physics/*.json
/progress/memory/g227-budget/native-*.json
/progress/memory/g227-budget/webkit-nalati-*.json
/progress/memory/g227-budget/isolated-gl-*.json
/progress/shard-platform/jake-reports/*.png

# G331: stitched sky working panels/logs are reproducible intermediates.
# Keep the selected JPEG references and final panoramas already in git.
/art/sunscar-dunes/round-25-sky/early/
/art/sunscar-dunes/round-25-sky/early2/
/art/sunscar-dunes/round-25-sky/mid/
/art/sunscar-dunes/round-25-sky/late/
/art/sunscar-dunes/round-25-sky/preview-mid.jpg

# G331: abandoned Sky terrain bake; no catalogue output or committed consumer.
/public/assets/baked/far-reach/terrain.bin
/public/assets/baked/far-reach/terrain.json

# Cold-authored Signal manifest queries (SHA256 pins in generation-jobs.json).
/public/assets/sunscar-dunes/ground/ring-mean.bin
/src/shards/sunscar-dunes/data/manifestGround.generated.json
/public/assets/pine-hollow/baked/wildlife.glb

# Driftwood declared navigation: cheap generated asset, retained input has navigation- prefix.
/src/shards/driftwood-isle/assets/c5185248a44d1f5c20c129e6bc25785ff6c1a81206f19f162d32cfe77131b464
/public/assets/pine-hollow/baked/undergrowth.glb
# Nalati declared navigation: cheap generated asset, retained input has navigation- prefix.
/src/shards/nalati-grasslands/assets/223ce1ab45d736c5fb526308cb86bc6d61bdeb482ac886a7d47306fd5a8c41b5
