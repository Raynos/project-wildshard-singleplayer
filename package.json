{
  "name": "wildshard-singleplayer",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "gen": "node scripts/gen.mjs",
    "dev": "bash scripts/serve-build.sh",
    "prebuild": "node scripts/check-css.mjs",
    "build": "pnpm gen && tsc --noEmit && node scripts/build-shardfiles.mjs && vite build && node scripts/check-devserver.mjs dist",
    "build:native": "vite build --mode native",
    "typecheck": "pnpm gen && tsc --noEmit && tsc -b tsconfig.layers.json && tsc --noEmit -p api && tsc --noEmit -p scripts && tsc --noEmit -p drafts && tsc --noEmit -p drafts/tools",
    "build:drafts": "vite build --config drafts/vite.config.ts",
    "atlas": "node drafts/tools/atlas.ts",
    "deploy:drafts": "bash drafts/tools/deploy.sh",
    "lint": "pnpm gen && oxlint",
    "lint:fix": "oxlint --fix",
    "lint:ratchet": "node lint/ratchet.mjs",
    "check:chunks": "node scripts/check-chunks.mjs dist",
    "audit:assets": "pnpm gen && node scripts/audit-assets.mjs",
    "test": "pnpm run test:checks && vitest run",
    "test:checks": "pnpm gen && node scripts/audit-assets.mjs && node scripts/check-model-sources.mjs && node scripts/check-paths.mjs && node scripts/check-graph.mjs && node scripts/gen-api.mjs --check && node lint/ratchet.mjs && node scripts/normalize/liveness.mjs --readme --check && node scripts/webgpu-inventory.mjs --check && node scripts/bake-check.mjs",
    "test:coverage": "vitest run --coverage && node scripts/coverage-ratchet.mjs",
    "test:gpu-boot": "bash scripts/test-nine-gpu-boot.sh",
    "preview": "vite preview",
    "assets": "node scripts/fetch-assets.mjs && node scripts/tex-tiers.mjs",
    "tex-tiers": "node scripts/tex-tiers.mjs",
    "timelapse": "bash scripts/timelapse.sh",
    "bench": "node scripts/bench-load.mjs",
    "bench:ci": "node scripts/bench-load.mjs --ci",
    "blender:island": "bash scripts/blender/build.sh driftwood-isle/island",
    "inbox:pull": "node scripts/inbox-pull.mjs",
    "native:sync": "pnpm build:native && cap sync && node scripts/native-paths.mjs",
    "native:ios": "bash scripts/native-ios.sh",
    "native:android": "bash scripts/native-android.sh"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@capacitor/preferences": "8.0.1",
    "@capgo/capacitor-updater": "8.51.21",
    "@dimforge/rapier3d-simd": "0.21.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/rajdhani": "5.3.0",
    "@sentry/browser": "11.0.0",
    "@vercel/blob": "2.8.0",
    "@wildshard/commons": "workspace:*",
    "@wildshard/engine": "workspace:*",
    "@wildshard/game": "workspace:*",
    "@wildshard/kit": "workspace:*",
    "@wildshard/sdk": "workspace:*",
    "fflate": "0.8.3",
    "n8ao": "^2.0.1",
    "navcat": "0.4.1",
    "postprocessing": "^6.39.5",
    "three": "^0.186.0",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@gltf-transform/cli": "^4.5.0",
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@types/node": "^24.13.6",
    "@types/three": "^0.186.0",
    "@typescript/typescript6": "6.0.2",
    "@vitest/coverage-v8": "5.0.1",
    "assemblyscript": "0.28.20",
    "binaryen": "132.0.0",
    "happy-dom": "20.14.5",
    "meshoptimizer": "1.2.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2002",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
