{
  "name": "wildshard-singleplayer",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "build": "node scripts/build-release.mjs",
    "pins:verify": "node scripts/engine-pin.mjs verify",
    "pins:bump": "node scripts/engine-pin.mjs bump",
    "check": "node scripts/check-shell.mjs && node scripts/vercel-prune-check.mjs && tsc -p api/tsconfig.json && node --test test/tooling/chrome-keychain.test.mjs && pnpm check:agents && pnpm check:parity",
    "check:agents": "node .githooks/agents-md.mjs lint",
    "check:parity": "node scripts/agent-parity.mjs --strict",
    "typecheck": "tsc -p api/tsconfig.json",
    "test": "node --test test/engine-pin.test.mjs test/shell-release.test.mjs test/release-worker.test.mjs test/release-train.test.mjs",
    "preview": "node scripts/preview-server.mjs"
  },
  "dependencies": {
    "@vercel/blob": "2.8.0",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "playwright": "1.65.0",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
