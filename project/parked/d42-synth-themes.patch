+// src/audio/score/driftwood-theme.ts — Driftwood Isle's theme, "Driftwood Tide" (docs/plans/MUSIC.md → "Per-shard themes").
+//
+// The Wildshard motif gone to sea. Same contour, same pitches bar for bar, so it is recognisably the theme — but:
+//   · D Mixolydian instead of Lydian: the lean G# → A becomes G → A (a whole step — sunnier, a folk / shanty colour),
+//     and the harmony is the island's I – bVII – IV – I (D – C – G – D | Bm7 – Em7 – G – A7sus4).
+//   · re-timed 3 + 3 + 2: the motif's first two notes are dotted (the tresillo lilt of calypso and a boat on a swell).
+//   · 92 bpm on the title, 88 calm (slower than Pine Hollow's 96 — the island breathes slower).
+//   · the palette turns over: the flute carries the motif, the marimba plays in its 'pan' tone (1 · 2 · 3 partials, a
+//     longer ring) as a steel pan with rolls on the long notes, the pluck is a ukulele skank on 2 and 4, the bass walks the
+//     tresillo, the drone is an open fifth (D + A — the horizon), low, because the surf bed carries the floor.
+// Form: A intro (4 bars) · B the motif on the flute, the pan answers (8) · C the pan in thirds, the flute's counter (8)
+// · D "the swell": Bm7 – G – D – A7sus4, the first interval called and answered (8) · B2 the pluck takes the motif (8)
+// · ring-out. Loops B2 → B (32 bars ≈ 87 s at 88).
+import {
+  bars, CHORD_ROOT, chordAt, fill, humanise, line, mix, MIXOLYDIAN, motif, motifThirds, shift, without,
+  type Arrangement, type ChordEv, type ChordName, type NoteEv, type Segment, type ThemeRules,
+} from './wildshard-theme';
+
+const BPM = 92;
+/** the motif in D Mixolydian, 3 + 3 + 2: `D. A. G A | E D — | D. A. B A | G E D` */
+export const ISLAND_MOTIF: NoteEv[] = line(
+  [0, 1.5, 62], [1.5, 1.5, 69], [3, 0.5, 67], [3.5, 0.5, 69],
+  [4, 1, 64], [5, 3, 62],
+  [8, 1.5, 62], [9.5, 1.5, 69], [11, 0.5, 71], [11.5, 0.5, 69],
+  [12, 1, 67], [13, 1, 64], [14, 2, 62],
+);
+const PHRASE: ChordName[] = ['D', 'C', 'G', 'D', 'Bm7', 'Em7', 'G', 'A7sus4'];
+const P8 = bars(...PHRASE);
+
+/** a steel-pan roll: a long note becomes repeated strikes every `every` beats, the first accented, the rest even and lighter */
+const roll = (notes: NoteEv[], min = 1.5, every = 1 / 3): NoteEv[] => notes.flatMap((x) => {
+  if (x.d < min) return [x];
+  const out: NoteEv[] = [];
+  for (let t = 0, i = 0; t < x.d - 0.05; t += every, i++) out.push({ t: x.t + t, d: every, n: x.n, v: (x.v ?? 0.8) * (i === 0 ? 1 : 0.62) });
+  return out;
+});
+/** the bass tresillo: root on 1, root on the 'and' of 2, the fifth on 4 */
+const tresilloBass = (chords: ChordEv[], beats: number, v = 0.85): NoteEv[] => {
+  const out: NoteEv[] = [];
+  for (let b = 0; b < beats; b += 4) {
+    const r = CHORD_ROOT[chordAt(chords, b)];
+    out.push({ t: b, d: 1.3, n: r, v }, { t: b + 1.5, d: 1.3, n: r, v: v * 0.8 }, { t: b + 3, d: 0.8, n: r + 7, v: v * 0.75 });
+  }
+  return out;
+};
+/** the ukulele skank: the chord's upper voices (an octave up) strummed on 2 and 4, a ghost on the 'and' of 3 */
+const skank = (chords: ChordEv[], beats: number, v = 0.5): NoteEv[] => {
+  const out: NoteEv[] = [];
+  const up: Partial<Record<ChordName, number[]>> = { D: [66, 69, 74], C: [64, 67, 72], G: [62, 67, 71], Bm7: [66, 69, 74], Em7: [64, 67, 71], A7sus4: [64, 67, 74], 'D6/9': [64, 69, 71] };
+  for (let b = 0; b < beats; b += 4) {
+    const tones = up[chordAt(chords, b)] ?? [66, 69, 74];
+    for (const [t, vv] of [[1, v], [3, v], [2.5, v * 0.45]] as [number, number][]) tones.forEach((n, i) => out.push({ t: b + t + i * 0.03, d: 0.35, n, v: vv * (1 - i * 0.12) }));
+  }
+  return out;
+};
+/** the island groove: swung shaker eighths (the offbeat late by a sixth of a beat), a rim tap on 2 & 4, a kick on 1 and the
+ *  'and' of 2 (the tresillo again), and the combat four-on-the-floor on 2, 3 and 4 */
+const groove = (beats: number): NoteEv[] => {
+  const out: NoteEv[] = [];
+  for (let b = 0; b < beats; b += 4) {
+    for (let i = 0; i < 8; i++) out.push({ t: b + i * 0.5 + (i % 2 ? 0.08 : 0), d: 0.2, n: 42, v: i % 2 ? 0.3 : i % 4 === 0 ? 0.5 : 0.42 });
+    out.push({ t: b + 1, d: 0.2, n: 38, v: 0.6 }, { t: b + 3, d: 0.2, n: 38, v: 0.65 });
+    out.push({ t: b, d: 0.3, n: 36, v: 1 }, { t: b + 1.5, d: 0.3, n: 36, v: 0.7 });
+    out.push({ t: b + 1, d: 0.3, n: 35, v: 0.85 }, { t: b + 2, d: 0.3, n: 35, v: 0.8 }, { t: b + 3, d: 0.3, n: 35, v: 0.85 });
+  }
+  return out;
