+//   ARRANGEMENTS.theme      Pine Hollow — the Wildshard theme (D Lydian, 104 / 96 bpm)          wildshard-theme.ts
+//   ARRANGEMENTS.island     Driftwood Isle — "Driftwood Tide" (D Mixolydian, 3+3+2, 92 / 88)    driftwood-theme.ts
+//   ARRANGEMENTS.citadel    the centre chunk — "The Citadel" (D Aeolian ground → Lydian, 76 / 72) citadel-theme.ts
+//   ARRANGEMENTS.trailer30 / trailer15   the trailer cuts of the Pine Hollow theme
+//
+//   scoreForChunk('driftwood-isle')  → 'island'   (a chunk not in CHUNK_SCORE gets the main theme)
+import { THEME, TRAILER15, TRAILER30, type Arrangement } from './wildshard-theme';
+import { ISLAND } from './driftwood-theme';
+import { CITADEL } from './citadel-theme';
+
+export const ARRANGEMENTS = { theme: THEME, island: ISLAND, citadel: CITADEL, trailer30: TRAILER30, trailer15: TRAILER15 } satisfies Record<string, Arrangement>;
+export type ArrangementName = keyof typeof ARRANGEMENTS;
+/** the in-game themes (the ones with a game-state table; the trailers are fixed cuts) */
+export const THEMES: ArrangementName[] = ['theme', 'island', 'citadel'];
+
+/** chunk slug (src/chunks/registry.ts) → its score. The citadel's slug goes here the day that chunk exists. */
+export const CHUNK_SCORE: Partial<Record<string, ArrangementName>> = {
+  'pine-hollow': 'theme',
+  'driftwood-isle': 'island',
+  'citadel': 'citadel',
+};
+export function scoreForChunk(slug: string): ArrangementName { return CHUNK_SCORE[slug] ?? 'theme'; }
