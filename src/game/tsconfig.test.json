{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "types": [
      "vite/client",
      "node"
    ],
    "rootDir": "../..",
    "outDir": "../../.tsc-layers/game",
    "tsBuildInfoFile": "../../.tsc-layers/game-tests.tsbuildinfo"
  },
  "references": [
    {
      "path": "../../tsconfig.engine.json"
    },
    {
      "path": "../engine/tsconfig.test.json"
    },
    {
      "path": "../../tsconfig.format.json"
    },
    {
      "path": "../../tsconfig.game.json"
    }
  ],
  "include": [
    "**/*.test.ts",
    "**/*.d.ts",
    "../engine/**/*.d.ts",
    "../game/**/*.merge.d.ts"
  ],
  "exclude": []
}
