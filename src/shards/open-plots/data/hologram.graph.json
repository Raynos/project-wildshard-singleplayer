{
  "version": 1,
  "kind": "material",
  "model": "unlit",
  "effectState": { "blend": "additive", "depthWrite": false, "fog": false, "singlePass": true },
  "doubleSided": true,
  "params": {
    "colour": { "type": "colour", "value": [0.2745, 0.902, 1] },
    "pivot": { "type": "vec3", "value": [0, 0, 0] },
    "spin": { "type": "float", "value": 0.22, "min": -2, "max": 2 },
    "base": { "type": "float", "value": 0.6 },
    "height": { "type": "float", "value": 12, "min": 1, "max": 64 }
  },
  "nodes": {
    "t": { "op": "time" },
    "spinP": { "op": "param", "param": "spin" },
    "ang": { "op": "mul", "in": ["t", "spinP"] },
    "ca": { "op": "cos", "in": ["ang"] },
    "sa": { "op": "sin", "in": ["ang"] },
    "pl": { "op": "positionLocal" },
    "pivotP": { "op": "param", "param": "pivot" },
    "d": { "op": "sub", "in": ["pl", "pivotP"] },
    "dx": { "op": "swizzle", "in": ["d"], "mask": "x" },
    "dz": { "op": "swizzle", "in": ["d"], "mask": "z" },
    "xc": { "op": "mul", "in": ["dx", "ca"] },
    "zs": { "op": "mul", "in": ["dz", "sa"] },
    "xr": { "op": "add", "in": ["xc", "zs"] },
    "zc": { "op": "mul", "in": ["dz", "ca"] },
    "xs": { "op": "mul", "in": ["dx", "sa"] },
    "zr": { "op": "sub", "in": ["zc", "xs"] },
    "ox": { "op": "sub", "in": ["xr", "dx"] },
    "oz": { "op": "sub", "in": ["zr", "dz"] },
    "offset": { "op": "combine", "in": ["ox", 0, "oz"] },
    "nl": { "op": "normalLocal" },
    "nx": { "op": "swizzle", "in": ["nl"], "mask": "x" },
    "ny": { "op": "swizzle", "in": ["nl"], "mask": "y" },
    "nz": { "op": "swizzle", "in": ["nl"], "mask": "z" },
    "nxc": { "op": "mul", "in": ["nx", "ca"] },
    "nzs": { "op": "mul", "in": ["nz", "sa"] },
    "nxr": { "op": "add", "in": ["nxc", "nzs"] },
    "nzc": { "op": "mul", "in": ["nz", "ca"] },
    "nxs": { "op": "mul", "in": ["nx", "sa"] },
    "nzr": { "op": "sub", "in": ["nzc", "nxs"] },
    "turned": { "op": "combine", "in": ["nxr", "ny", "nzr"] },

    "nw": { "op": "normalWorld" },
    "pw": { "op": "positionWorld" },
    "cam": { "op": "cameraPosition" },
    "toCam": { "op": "sub", "in": ["cam", "pw"] },
    "view": { "op": "normalize", "in": ["toCam"] },
    "ndv": { "op": "dot", "in": ["nw", "view"] },
    "ndvA": { "op": "abs", "in": ["ndv"] },
    "ndvS": { "op": "saturate", "in": ["ndvA"] },
    "rim0": { "op": "oneMinus", "in": ["ndvS"] },
    "rim": { "op": "pow", "in": ["rim0", 2.2] },
    "rimK": { "op": "mul", "in": ["rim", 0.7] },

    "vc": { "op": "vertexColour" },
    "bary": { "op": "mul", "in": ["vc", 2] },
    "bw": { "op": "fwidth", "in": ["bary"] },
    "wFrac": { "op": "fract", "in": ["bary"] },
    "wDist": { "op": "div", "in": ["wFrac", "bw"] },
    "wSat": { "op": "saturate", "in": ["wDist"] },
    "wire3": { "op": "oneMinus", "in": ["wSat"] },
    "wireX": { "op": "swizzle", "in": ["wire3"], "mask": "x" },
    "wireY": { "op": "swizzle", "in": ["wire3"], "mask": "y" },
    "wireZ": { "op": "swizzle", "in": ["wire3"], "mask": "z" },
    "wireXY": { "op": "max", "in": ["wireX", "wireY"] },
    "wire": { "op": "max", "in": ["wireXY", "wireZ"] },
    "wireK": { "op": "mul", "in": ["wire", 0.07] },
    "fDist": { "op": "div", "in": ["bary", "bw"] },
    "fWide": { "op": "mul", "in": ["fDist", 0.6] },
    "fSat": { "op": "saturate", "in": ["fWide"] },
    "feat3": { "op": "oneMinus", "in": ["fSat"] },
    "featX": { "op": "swizzle", "in": ["feat3"], "mask": "x" },
    "featY": { "op": "swizzle", "in": ["feat3"], "mask": "y" },
    "featZ": { "op": "swizzle", "in": ["feat3"], "mask": "z" },
    "featXY": { "op": "max", "in": ["featX", "featY"] },
    "feat": { "op": "max", "in": ["featXY", "featZ"] },
    "featK": { "op": "mul", "in": ["feat", 0.55] },

    "wy": { "op": "swizzle", "in": ["pw"], "mask": "y" },
    "scanA": { "op": "mul", "in": ["wy", 18] },
    "scanS": { "op": "sin", "in": ["scanA"] },
    "scanH": { "op": "mul", "in": ["scanS", 0.5] },
    "scanU": { "op": "add", "in": ["scanH", 0.5] },
    "scanP": { "op": "pow", "in": ["scanU", 6] },
    "scanK": { "op": "mul", "in": ["scanP", 0.12] },
    "baseP": { "op": "param", "param": "base" },
    "heightP": { "op": "param", "param": "height" },
    "cycle": { "op": "mul", "in": ["t", 0.11] },
    "phase": { "op": "fract", "in": ["cycle"] },
    "reach": { "op": "add", "in": ["heightP", 4] },
    "climb": { "op": "mul", "in": ["phase", "reach"] },
    "bandBase": { "op": "sub", "in": ["baseP", 2] },
    "bandY": { "op": "add", "in": ["bandBase", "climb"] },
    "bandD": { "op": "sub", "in": ["wy", "bandY"] },
    "bandA": { "op": "abs", "in": ["bandD"] },
    "bandS": { "op": "smoothstep", "in": [0, 1.5, "bandA"] },
    "band": { "op": "oneMinus", "in": ["bandS"] },
    "sweepK": { "op": "mul", "in": ["band", 0.35] },

    "a0": { "op": "add", "in": [0.07, "rimK"] },
    "a1": { "op": "add", "in": ["a0", "wireK"] },
    "a2": { "op": "add", "in": ["a1", "featK"] },
    "a3": { "op": "add", "in": ["a2", "scanK"] },
    "a4": { "op": "add", "in": ["a3", "sweepK"] },
    "pv": { "op": "positionView" },
    "depth": { "op": "length", "in": ["pv"] },
    "fadeS": { "op": "smoothstep", "in": [300, 850, "depth"] },
    "keep": { "op": "oneMinus", "in": ["fadeS"] },
    "a5": { "op": "mul", "in": ["a4", "keep"] },
    "alpha": { "op": "saturate", "in": ["a5"] },
    "colourP": { "op": "param", "param": "colour" }
  },
  "stages": {
    "vertex.offset": { "offset": "offset" },
    "vertex.normal": { "normal": "turned" },
    "surface": { "colour": "colourP", "alpha": "alpha" }
  }
}
