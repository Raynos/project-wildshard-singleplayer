{
  "version": 1,
  "modules": {
    "@wildshard/game/plugin/simulation": [
      "addBakedPieces"
    ],
    "@wildshard/engine/physics/surface": [
      "tagOf"
    ],
    "@wildshard/format/portalLinkAssets": [
      "portalLinkEntries"
    ],
    "@wildshard/game/grapple/headless": [
      "installGrapple"
    ],
    "@wildshard/format/grapple": [
      "parseGrappleProfile"
    ],
    "@wildshard/game/shardfile/portalRideBinding": [
      "installHostPortalRide"
    ],
    "@wildshard/game/plugin/nativeItems": [
      "installNativeItems"
    ]
  },
  "constants": {
    "portalStep": "nine-dragon-stack.portals",
    "jianStep": "item.weapon.jian",
    "jianPolicy": {
      "kind": "swept",
      "step": "item.weapon.jian",
      "eye": 1.68,
      "initial": 0,
      "source": "owner",
      "slots": [
        {
          "item": "weapon.jian",
          "weapon": "weapon.jian",
          "tags": [],
          "combo": [
            "weapon.jian.slash",
            "weapon.jian.backhand",
            "weapon.jian.finisher"
          ],
          "heavy": "weapon.jian.heavy"
        }
      ],
      "contact": {
        "slack": 0,
        "direction": [
          0,
          0,
          0
        ],
        "push": [
          0,
          0
        ],
        "running": 0
      },
      "lunge": {
        "maxHeight": 0,
        "minDistance": 0.01,
        "minRadius": 0,
        "lengthScale": 0
      }
    }
  },
  "prepare": [
    {
      "name": "payload",
      "value": {
        "$call": [
          {
            "$ref": [
              "assembly",
              "json"
            ]
          },
          {
            "$ref": [
              "product"
            ]
          },
          "sim/headless-constants.json"
        ]
      }
    },
    {
      "name": "grapple",
      "value": {
        "$call": [
          {
            "$ref": [
              "assembly",
              "need"
            ]
          },
          {
            "$call": [
              {
                "$fn": {
                  "$call": [
                    {
                      "$ref": [
                        "args",
                        0,
                        "find"
                      ]
                    },
                    {
                      "$fn": {
                        "$eq": [
                          {
                            "$ref": [
                              "args",
                              0,
                              "id"
                            ]
                          },
                          "grapple"
                        ]
                      }
                    }
                  ]
                }
              },
              {
                "$ref": [
                  "shard",
                  "modes",
                  "grapple"
                ]
              }
            ]
          },
          "Nine Dragon declares its grapple mode"
        ]
      }
    },
    {
      "name": "portalEntries",
      "value": {
        "$call": [
          {
            "$ref": [
              "@wildshard/format/portalLinkAssets",
              "portalLinkEntries"
            ]
          },
          {
            "$ref": [
              "shard",
              "entryways"
            ]
          }
        ]
      }
    },
    {
      "name": "fourEntries",
      "value": {
        "$call": [
          {
            "$ref": [
              "assembly",
              "need"
            ]
          },
          {
            "$if": [
              {
                "$eq": [
                  {
                    "$ref": [
                      "portalEntries",
                      "length"
                    ]
                  },
                  4
                ]
              },
              true,
              {
                "$ref": [
                  "absent"
                ]
              }
            ]
          },
          "Nine Dragon declares four portal-link entryways"
        ]
      }
    }
  ],
  "install": [
    {
      "name": "collision",
      "value": {
        "$if": [
          {
            "$ref": [
              "context",
              "restoring"
            ]
          },
          {
            "$ref": [
              "absent"
            ]
          },
          {
            "$call": [
              {
                "$ref": [
                  "@wildshard/game/plugin/simulation",
                  "addBakedPieces"
                ]
              },
              {
                "$ref": [
                  "host",
                  "physics"
                ]
              },
              {
                "$ref": [
                  "payload",
                  "pieces"
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "name": "guard",
      "value": {
        "$if": [
          {
            "$ref": [
              "context",
              "restoring"
            ]
          },
          [],
          {
            "$call": [
              {
                "$fn": {
                  "$call": [
                    {
                      "$ref": [
                        "args",
                        0,
                        "map"
                      ]
                    },
                    {
                      "$fn": {
                        "$ref": [
                          "args",
                          0,
                          "handle"
                        ]
                      }
                    }
                  ]
                }
              },
              {
                "$call": [
                  {
                    "$fn": {
                      "$call": [
                        {
                          "$ref": [
                            "args",
                            0,
                            "filter"
                          ]
                        },
                        {
                          "$fn": {
                            "$call": [
                              {
                                "$fn": {
                                  "$eq": [
                                    {
                                      "$ref": [
                                        "args",
                                        0,
                                        "owner"
                                      ]
                                    },
                                    "nds-grapple-guard"
                                  ]
                                }
                              },
                              {
                                "$call": [
                                  {
                                    "$ref": [
                                      "@wildshard/engine/physics/surface",
                                      "tagOf"
                                    ]
                                  },
                                  {
                                    "$ref": [
                                      "args",
                                      0
                                    ]
                                  }
                                ]
                              }
                            ]
                          }
                        }
                      ]
                    }
                  },
                  {
                    "$call": [
                      {
                        "$ref": [
                          "host",
                          "physics",
                          "world",
                          "colliders",
                          "getAll"
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "name": "jianOwner",
      "value": {
        "$call": [
          {
            "$ref": [
              "@wildshard/game/plugin/nativeItems",
              "installNativeItems"
            ]
          },
          {
            "$ref": [
              "host"
            ]
          },
          {
            "$ref": [
              "context",
              "combat"
            ]
          },
          {
            "kind": "swept",
            "items": {
              "$ref": [
                "shard",
                "items",
                "rows"
              ]
            },
            "policy": {
              "$ref": [
                "constants",
                "jianPolicy"
              ]
            }
          }
        ]
      }
    },
    {
      "name": "fact",
      "value": {
        "$fn": {
          "$call": [
            {
              "$ref": [
                "context",
                "emit"
              ]
            },
            {
              "kind": "fact",
              "name": {
                "$ref": [
                  "args",
                  0
                ]
              },
              "actorId": {
                "$ref": [
                  "args",
                  1
                ]
              }
            }
          ]
        }
      }
    },
    {
      "name": "portalOwner",
      "value": {
        "$call": [
          {
            "$ref": [
              "@wildshard/game/shardfile/portalRideBinding",
              "installHostPortalRide"
            ]
          },
          {
            "$ref": [
              "host"
            ]
          },
          {
            "$ref": [
              "constants",
              "portalStep"
            ]
          },
          {
            "$ref": [
              "shard"
            ]
          },
          {
            "$ref": [
              "payload",
              "portalRide"
            ]
          },
          {
            "$ref": [
              "fact"
            ]
          }
        ]
      }
    },
    {
      "name": "grappleOwner",
      "value": {
        "$call": [
          {
            "$ref": [
              "@wildshard/game/grapple/headless",
              "installGrapple"
            ]
          },
          {
            "$ref": [
              "host"
            ]
          },
          {
            "$ref": [
              "context"
            ]
          },
          {
            "$call": [
              {
                "$ref": [
                  "@wildshard/format/grapple",
                  "parseGrappleProfile"
                ]
              },
              {
                "$ref": [
                  "payload",
                  "grappleProfile"
                ]
              }
            ]
          },
          {
            "$ref": [
              "grapple"
            ]
          },
          {
            "$ref": [
              "payload",
              "hooks"
            ]
          },
          {
            "$ref": [
              "guard"
            ]
          }
        ]
      }
    }
  ],
  "level": {
    "ground": {
      "size": 500,
      "height": 0
    },
    "speed": 5,
    "lift": {
      "$ref": [
        "payload",
        "spawnY"
      ]
    }
  },
  "ports": {
    "ground": false,
    "heightAt": {
      "$fn": 0
    }
  },
  "entries": {
    "$fn": {
      "$ref": [
        "payload",
        "entryProof"
      ]
    }
  }
}
