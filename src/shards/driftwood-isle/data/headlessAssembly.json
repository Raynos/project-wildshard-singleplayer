    "@wildshard/sdk/headlessRuntime": ["bindHeadlessCommands"],
    "@wildshard/game/population/nativeBake": ["installNativeCollision", "nativeBakeGround", "nativeBakeFloats"],
    "@wildshard/game/shardfile/borrowedDecisions": ["nativeDecisionAuthority"],
    "@wildshard/game/plugin/nativeItems": ["installNativeItems"],
    "@wildshard/game/plugin/mover": ["proveTerrainEntries"],
    "@wildshard/format/terrainTileBytes": ["terrainTileHeight"]
  },
  "prepare": [
    {
      "name": "bossView",
      "value": {
        "$call": [
          {
            "$ref": [
              "product",
              "section"
            ]
          },
          "custom/fixedLayouts"
        ]
      }
    },
    {
      "name": "countersJson",
