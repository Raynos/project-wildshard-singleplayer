  ],
  "level": {
    "ground": {
      "size": 500,
      "height": 0
    },
    "speed": 5,
    "lift": 0.1
  },
  "ports": {
    "ground": false,
    "heightAt": {
      "$ref": ["heightAt"]
    }
  },
  "entries": {
    "$fn": {
      "$call": [
        {
          "$ref": ["@wildshard/game/plugin/mover", "proveTerrainEntries"]
        },
        {
          "$ref": ["args", 0, "physics"]
        },
        {
          "$ref": ["shard", "entryways"]
        },
        {
          "$ref": ["heightAt"]
        },
        {
          "$ref": ["constants", "entries"]
