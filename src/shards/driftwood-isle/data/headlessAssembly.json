            "$ref": [
              "constants",
              "dayStyle"
            ]
          },
          {
            "dusk": "dusk"
          }
        ]
      }
    },
    {
      "name": "clock",
      "value": {
        "$new": [
          {
            "$ref": ["@wildshard/engine/world/dayCycle", "DayCycle"]
          },
          {
            "$call": [
              {
                "$ref": ["assembly", "merge"]
              },
              {"$ref": ["dayLook", "spec"]},
              {
                "start": 0.16666666666666669
              }
            ]
          }
        ]
      }
    },
    {
      "name": "cycle",
      "value": {
        "$set": [
          {
            "$ref": ["clock"]
          },
          "cycle",
          2880
        ]
      }
    },
    {
      "name": "day",
      "value": {
        "$call": [
          {
            "$ref": ["host", "useDayClock"]
          },
          {
            "$ref": ["clock"]
          }
        ]
      }
    },
    {
      "name": "water",
      "value": {
        "$call": [
          {
            "$ref": ["host", "useWater"]
          },
          {
            "surfaceAt": {
              "$ref": ["src/shards/driftwood-isle/world/sea", "DRIFTWOOD_SEA", "restAt"]
            },
            "bob": {
              "$fn": {
                "$call": [
                  {
                    "$ref": ["@wildshard/engine/world/waves", "waveHeight"]
                  },
                  {
                    "$ref": ["args", 0]
                  },
                  {
                    "$ref": ["args", 1]
                  },
                  {
                    "$ref": ["host", "clock", "now"]
                  }
                ]
              }
            }
          }
        ]
      }
    },
    {
      "name": "world",
      "value": {
        "$if": [
          {
            "$not": {
              "$ref": ["context", "restoring"]
            }
          },
          {
            "$call": [
              {
                "$ref": ["@wildshard/game/population/nativeBake", "installNativeCollision"]
              },
              {
                "$ref": ["host"]
              },
              {
                "$ref": ["bake"]
              },
              {
                "resolution": 256
              }
            ]
          },
          {
            "$ref": ["absent"]
          }
        ]
      }
    },
    {
      "name": "populationDecisions",
      "value": {
        "$call": [
          {
            "$ref": [
              "@wildshard/game/shardfile/borrowedDecisions",
              "nativeDecisionAuthority"
            ]
          },
          {
            "$ref": [
              "shard"
            ]
          },
          {
            "$ref": [
              "assets"
            ]
          },
          {
            "$ref": [
              "host"
            ]
          }
        ]
      }
    },
    {
      "name": "island",
      "value": {
        "$call": [
          {
            "$ref": [
              "@wildshard/game/population/mixedRoster",
              "installMixedPopulation"
