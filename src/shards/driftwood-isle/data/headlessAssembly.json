          {
            "$ref": ["product"]
          },
          "quests/achievements.json"
        ]
      }
    },
    {
      "name": "counters",
      "value": {
        "$call": [
          {
            "$ref": ["@wildshard/format/achievementCounters", "parseAchievementCounterData"]
          },
          {
            "$ref": ["countersJson"]
          }
        ]
      }
    },
    {
      "name": "species",
      "value": {
        "$call": [
          {
            "$ref": ["product", "section"]
          },
          "actors/species-programs"
        ]
      }
    },
    {
      "name": "program",
      "value": {
        "$call": [
          {
            "$ref": ["assembly", "need"]
          },
          {
            "$ref": ["species", "program"]
          },
          "Driftwood requires its admitted species program"
        ]
      }
    },
    {
      "name": "fauna",
      "value": {
        "$new": [
          {
            "$ref": ["assembly", "Map"]
          },
          {
            "$call": [
              {
                "$ref": ["species", "native", "map"]
              },
              {
                "$fn": [
                  {
                    "$ref": ["args", 0, "kind"]
                  },
                  {
                    "$ref": ["args", 0]
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "name": "placementJson",
      "value": {
        "$call": [
          {
            "$ref": ["assembly", "json"]
          },
          {
            "$ref": ["product"]
          },
          "sim/enemy-placement.json",
          false
        ]
      }
    },
    {"name": "placement", "value": {"$ref": ["placementJson"]}},
    {
      "name": "monkeyJson",
      "value": {
        "$call": [
          {
            "$ref": ["assembly", "json"]
          },
          {
            "$ref": ["product"]
          },
          "poses/monkey.json",
          true
        ]
      }
    },
    {
      "name": "keeperJson",
      "value": {
        "$call": [
          {
            "$ref": ["assembly", "json"]
          },
          {
            "$ref": ["product"]
          },
          "sim/keeper.json",
          false
        ]
      }
    },
    {"name": "keeper", "value": {"$ref": ["keeperJson"]}},
    {
      "name": "launch",
      "value": {
        "$call": [
          {
            "$ref": ["assembly", "need"]
          },
          {
            "$ref": ["shard", "items", "launches", "coconut"]
          },
          "Driftwood requires its admitted coconut launch"
        ]
      }
    },
    {
      "name": "navigation",
      "value": {
        "$call": [
          {
            "$ref": ["assembly", "need"]
          },
          {
            "$call": [
              {
                "$ref": ["assets", "get"]
              },
              {
                "$ref": ["shard", "navigation", "file"]
              }
            ]
          },
          "Driftwood requires its admitted navigation asset"
        ]
      }
    },
    {
      "name": "director",
      "value": {
        "$call": [
          {
            "$ref": ["@wildshard/game/plugin/director", "readDirectorProduct"]
          },
          {
            "$ref": ["product"]
          }
        ]
      }
    },
    {"name": "ground", "value": {"$call": [{"$ref": ["@wildshard/game/population/nativeBake", "nativeBakeGround"]}, {"$ref": ["constants", "physics", "ground"]}, 256, 500, "Driftwood"]}},
    {"name": "bake", "value": {"actors": {"$ref": ["constants", "physics", "actors"]}, "herds": {"$ref": ["constants", "physics", "herds"]}, "habitat": {"$ref": ["constants", "physics", "habitat"]}, "captain": {"$ref": ["constants", "physics", "captain"]}, "ground": {"$ref": ["ground"]}, "solids": {"$call": [{"$ref": ["constants", "physics", "solids", "map"]}, {"$fn": {"$if": [{"$ref": ["args", 0, "vertices"]}, {"$call": [{"$ref": ["assembly", "merge"]}, {"$ref": ["args", 0]}, {"points": {"$call": [{"$ref": ["@wildshard/game/population/nativeBake", "nativeBakeFloats"]}, {"$ref": ["args", 0, "vertices"]}]}}]}, {"$ref": ["args", 0]}]}}]}}},
    {"name": "specs", "value": {"$new": [{"$ref": ["assembly", "Map"]}, {"$ref": ["constants", "nativeSpecs"]}]}},
    {"name": "heightAt", "value": {"$fn": {"$call": [{"$ref": ["@wildshard/format/terrainTileBytes", "terrainTileHeight"]}, {"resolution": 256, "x": -250, "z": -250, "size": 500, "heights": {"$ref": ["ground", "heights"]}}, {"$ref": ["args", 0]}, {"$ref": ["args", 1]}, {"layout": "column-major", "boundary": "clamp"}]}}},
    {
      "name": "nav",
      "value": {
        "$call": [
          {
            "$ref": ["@wildshard/engine/physics/navmesh", "readNavmesh"]
          },
          {
            "$ref": ["navigation"]
          },
          "Driftwood declared navigation does not parse",
          {
            "$fn": 0
          }
        ]
      }
    },
    {
      "name": "spots",
      "value": {
        "$call": [
          {
            "$ref": [
              "@wildshard/game/quest/nativeComposition",
              "readNativeQuestSpots"
            ]
          },
          {
            "$ref": [
              "constants",
              "nativeQuestSpots"
            ]
          }
        ]
      }
    }
  ],
  "install": [
    {
      "name": "dayLook",
      "value": {
        "$call": [
          {
            "$ref": [
              "@wildshard/game/looks/dayClock",
              "dayClock"
            ]
          },
          {
            "$ref": [
