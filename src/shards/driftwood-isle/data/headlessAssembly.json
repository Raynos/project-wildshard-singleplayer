              "$ref": [
                "constants",
                "interact"
              ]
            },
            "spots": {
              "$ref": [
                "spots"
              ]
            },
            "counters": {
              "$ref": [
                "constants",
                "nativeCounters"
              ]
            },
            "props": {
              "$ref": [
                "constants",
                "questProps"
              ]
            },
            "restoring": {
              "$ref": [
                "context",
                "restoring"
              ]
            },
            "rows": {
              "$ref": [
                "constants",
                "nativeQuest"
              ]
            }
          }
        ]
      }
    },
    {
      "name": "settle",
      "value": {
        "$call": [
          {
            "$ref": ["island", "settle"]
          }
        ]
      }
    },
    {
      "name": "poses",
      "value": {
        "$call": [
          {
            "$ref": ["host", "onStep"]
          },
          "driftwood.poses",
          {
            "$ref": ["island", "publishPoses"]
          },
          {
            "$ref": ["absent"]
          },
          "afterBodies"
        ]
