                  "nativeChapterCues"
                ]
              }
            }
          },
          {
            "$ref": [
              "context",
              "restoring"
            ]
          }
        ]
      }
    },
    {
      "name": "input",
      "value": {
        "$call": [
          {
            "$ref": [
              "@wildshard/sdk/headlessRuntime",
              "bindHeadlessCommands"
            ]
          },
          {
            "$ref": [
              "context"
            ]
          },
          {
            "$ref": [
              "host"
            ]
          }
        ]
      }
    },
    {
