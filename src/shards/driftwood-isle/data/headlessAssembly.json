{
  "version": 1,
  "modules": {
    "@wildshard/game/population/mixedRoster": ["installMixedPopulation"],
    "@wildshard/game/quest/nativeChapter": ["installNativeChapterDirector"],
    "@wildshard/game/quest/killSteps": ["installQuestKillSteps"],
    "@wildshard/game/quest/nativeComposition": ["readNativeQuestSpots", "installNativeQuestComposition"],
    "src/shards/driftwood-isle/world/sea": ["DRIFTWOOD_SEA", "LOWERED_SEA"],
    "@wildshard/game/looks/dayClock": ["dayClock"],
    "@wildshard/format/toonLook": ["TOON_DAY_PRESET"],
    "@wildshard/format/achievementCounters": ["parseAchievementCounterData"],
