                "bake",
                "captain"
              ]
            },
            "placement": {
              "$ref": [
                "placement"
              ]
            },
            "keeper": {
              "$ref": [
                "keeper"
              ]
            },
            "fauna": {
              "$ref": [
                "fauna"
              ]
            },
            "launch": {
              "$ref": [
                "launch"
              ]
            },
            "population": {
              "$ref": [
                "species"
              ]
            },
            "bake": {
              "ground": {
                "$ref": [
                  "bake",
                  "ground"
                ]
              },
              "actors": {
                "$ref": [
                  "bake",
                  "actors"
                ]
              },
              "herds": {
                "$ref": [
                  "bake",
                  "herds"
                ]
              },
              "habitat": {
                "$ref": [
                  "bake",
                  "habitat"
                ]
              }
            },
            "specs": {
              "$ref": [
                "specs"
              ]
            },
            "seed": {
              "$ref": [
                "shard",
                "identity",
                "seed"
              ]
            },
            "waterLevel": {
              "$ref": [
                "src/shards/driftwood-isle/world/sea",
                "LOWERED_SEA"
              ]
            },
            "spawnY": {
              "$ref": [
                "shard",
                "spawn",
                "y"
              ]
            },
            "nav": {
              "$ref": [
                "nav"
              ]
            }
          },
          {
            "$ref": [
              "context",
              "snapshot"
            ]
          }
        ]
      }
    },
    {
      "name": "finale",
      "value": {
        "$call": [
          {
            "$ref": [
              "@wildshard/game/quest/nativeChapter",
              "installNativeChapterDirector"
            ]
          },
          {
            "$ref": [
              "host"
            ]
          },
          {
            "$ref": [
              "director"
            ]
          },
          {
            "id": {
              "$ref": [
                "constants",
                "nativeQuest",
                "reward",
                "director"
              ]
            },
            "rows": {
              "$ref": [
                "constants",
                "chapterDirector"
              ]
            },
            "reward": {
              "$ref": [
                "constants",
                "nativeQuest",
                "reward",
                "channels"
              ]
            },
            "wake": {
              "population": {
                "$ref": [
                  "constants",
                  "nativeQuest",
                  "acquisition",
                  "population"
                ]
              },
              "encounter": {
                "$ref": [
                  "bossView",
                  "nativeView",
                  "BOSS_ENCOUNTER"
                ]
              },
              "placement": {
                "pool": {
                  "x": {
                    "$ref": [
                      "bake",
                      "captain",
                      "pool",
                      "x"
                    ]
                  },
                  "z": {
                    "$ref": [
                      "bake",
                      "captain",
                      "pool",
                      "z"
                    ]
