{
  "name": "@wildshard/sdk",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    "./version": "./version.ts",
    "./shardfile": "./shardfile.ts",
    "./author": "./author.ts",
    "./assets": "./assets.ts",
    "./project": "./project.ts",
    "./ledger": "./ledger.ts",
    "./bake/terrain": "./bake/terrain.ts",
    "./quests": "./quests.ts"
  },
  "bin": {
    "wildshard": "./bin/wildshard.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "prepack": "node ../../scripts/build-sdk.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "valibot": "1.5.0",
    "vite": "^8.3.0"
  },
  "publishConfig": {
    "exports": {
      "./version": {
        "types": "./dist/types/sdk/version.d.ts",
        "default": "./dist/version.js"
      },
      "./shardfile": {
        "types": "./dist/types/sdk/shardfile.d.ts",
        "default": "./dist/shardfile.js"
      },
      "./author": {
        "types": "./dist/types/sdk/author.d.ts",
        "default": "./dist/author.js"
      },
      "./assets": {
        "types": "./dist/types/sdk/assets.d.ts",
        "default": "./dist/assets.js"
      },
      "./project": {
        "types": "./dist/types/sdk/project.d.ts",
        "default": "./dist/project.js"
      },
      "./ledger": {
        "types": "./dist/types/sdk/ledger.d.ts",
        "default": "./dist/ledger.js"
      },
      "./bake/terrain": {
        "types": "./dist/types/sdk/bake/terrain.d.ts",
        "default": "./dist/bake/terrain.js"
      },
      "./quests": {
        "types": "./dist/types/sdk/quests.d.ts",
        "default": "./dist/quests.js"
      }
    }
  }
}
