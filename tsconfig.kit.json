{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "outDir": ".tsc-layers/kit",
    "tsBuildInfoFile": ".tsc-layers/kit.tsbuildinfo"
  },
  "references": [{ "path": "./tsconfig.engine.json" }, { "path": "./tsconfig.game.json" }],
  "include": ["src/kit", "src/engine/**/*.d.ts", "src/game/**/*.merge.d.ts"]
}
