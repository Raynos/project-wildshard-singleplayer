#!/usr/bin/env bash
# D8: storage is enforced at commit; CI owns generation and complete builds.
# The scheduled pusher already checked this exact candidate in its 45s budget.
# AGENTS.md (J241, meta REPO-KIT K10): .githooks/agents-md.mjs judges the same
# ref lines on every push, the scheduled pusher's included; docs/agents-md.md.
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
refs="$(cat)"
while read -r _local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = refs/heads/main ] || continue
  [ "$local_sha" = 0000000000000000000000000000000000000000 ] && continue
  if [ "${WS_LIVE_GATE_TIP:-}" = "$local_sha" ] && [ "${WS_LIVE_GATE_BASE:-}" = "$remote_sha" ]; then continue; fi
  python3 "$root/scripts/push-loop.py" --check "$local_sha" || exit 1
done <<< "$refs"
printf '%s\n' "$refs" | node "$root/.githooks/agents-md.mjs" push
