#!/usr/bin/env bash
# post-commit: auto-commit a dirty sweep-guard ledger.
#
# guard-git-add-all.sh appends a line to project/sweepguard-ledger.md on
# every SKIP_SWEEPGUARD=1 use. Pathspec commits (this repo's mandatory shape)
# build their temp index from HEAD + the NAMED paths only, so a pre-commit hook
# cannot fold the ledger into the same commit — instead this hook sweeps a
# dirty ledger into its own tiny follow-up commit the moment any commit lands.
# Mechanical, can't be forgotten; recursion is cut by LEDGER_AUTOCOMMIT.

set -uo pipefail

[ "${LEDGER_AUTOCOMMIT:-0}" = "1" ] && exit 0

repo="$(git rev-parse --show-toplevel 2>/dev/null || exit 0)"
ledger="project/sweepguard-ledger.md"

if ! git -C "$repo" diff --quiet HEAD -- "$ledger" 2>/dev/null; then
  LEDGER_AUTOCOMMIT=1 \
    git -C "$repo" commit -q -m "Sweep-guard ledger: bypass entries (auto, .githooks/post-commit)" -- "$ledger" \
    && echo "  - sweep-guard ledger was dirty -> auto-committed" >&2 \
    || echo "  !! sweep-guard ledger is dirty and the auto-commit FAILED - commit $ledger yourself" >&2
fi

# E357: the ratchet on the commit just made (its own tree, not the shared working tree): a rise here blocks every push,
# so say so loudly now. Advisory (a post-commit hook cannot refuse); ~3 s.
if [ -f "$repo/lint/ratchet.mjs" ]; then
  tmp="$(cd "$(mktemp -d /tmp/ratchet-commit.XXXXXX)" && pwd -P)" # canonical: /tmp is a symlink on macOS (E432)
  # the ratchet reads both oxlint configs and (since E362 AG16/17) scripts/guard-counts.mjs; archive only what HEAD has
  paths="src lint .oxlintrc.ratchet.json package.json"
  for extra in .oxlintrc.json scripts/guard-counts.mjs scripts/legacy-shards.mjs; do git -C "$repo" cat-file -e "HEAD:$extra" 2>/dev/null && paths="$paths $extra"; done
  # shellcheck disable=SC2086 # word-split on purpose: a list of literal paths
  git -C "$repo" archive HEAD -- $paths | tar -x -C "$tmp" 2>/dev/null
  node "$repo/scripts/link-node-modules.mjs" "$repo" "$tmp" # E432: @wildshard/* resolve to this export, not the working tree
  if ! out="$(cd "$tmp" && node lint/ratchet.mjs 2>&1)"; then
    echo "" >&2
    echo "  !! RATCHET ROSE in the commit you just made ($(git -C "$repo" rev-parse --short HEAD)): it blocks every push. Fix it now:" >&2
    echo "$out" | grep -E "was|rose" | head -12 | sed 's/^/     /' >&2
  fi
  rm -rf "$tmp"
fi

exit 0
