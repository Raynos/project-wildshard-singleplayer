#!/usr/bin/env bash
# post-commit: auto-commit a dirty sweep-guard ledger.
#
# guard-git-add-all.sh appends a line to project/sweepguard-ledger.md on
# every SKIP_SWEEPGUARD=1 use. Pathspec commits (this repo's mandatory shape)
# build their temp index from HEAD + the NAMED paths only, so a pre-commit hook
# cannot fold the ledger into the same commit — instead this hook sweeps a
# dirty ledger into a detached follow-up after the owning commit exits.
# Redirect the whole detached launcher so its shell cannot retain a captured caller pipe.
# Never nest a Git commit under its parent's message lock. Recursion is cut by LEDGER_AUTOCOMMIT.

set -uo pipefail

repo="$(git rev-parse --show-toplevel 2>/dev/null || exit 0)"
ledger="project/sweepguard-ledger.md"
common="$(git -C "$repo" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"

if [ "${LEDGER_AUTOCOMMIT:-0}" != 1 ] && ! git -C "$repo" diff --quiet HEAD -- "$ledger" 2>/dev/null; then
  source="$(git -C "$repo" rev-parse HEAD)"
  (cd "$repo" && exec python3 -c 'import os, sys; os.setsid(); os.execvp(sys.argv[1], sys.argv[1:])' \
    python3 scripts/commit-sweep-ledger.py "$PPID" "$source") \
    < /dev/null >> "$common/sweep-ledger.log" 2>&1 &
  echo "  - dirty sweep ledger deferred until parent PID $PPID exits" >&2
fi

# SF74 W14: the automatic pusher. Record which herdr pane made this commit (a red push pings that lane), then start
# scripts/auto-push.sh detached in its own session so the commit returns at once; it batches, queues behind a push in
# flight and is single-instance. Off: `touch .git/auto-push.off`. A feature worktree / other branch is skipped inside.
if [ -n "$common" ] && [ -n "${HERDR_PANE_ID:-}" ]; then
  printf '{"sha":"%s","pane":"%s","at":%s}\n' "$(git -C "$repo" rev-parse HEAD)" "$HERDR_PANE_ID" "$(date +%s)" >> "$common/commit-lanes.jsonl" 2>/dev/null || true
fi
if [ -f "$repo/scripts/auto-push.sh" ]; then
  (cd "$repo" && exec python3 -c 'import os, sys; os.setsid(); os.execvp(sys.argv[1], sys.argv[1:])' bash scripts/auto-push.sh) \
    < /dev/null > /dev/null 2>&1 &
fi

# E357: the ratchet on the commit just made (its own tree, not the shared working tree): a rise blocks every push.
# SF74 W18 (speed audit #3): it runs detached in scripts/commit-ratchet.sh, so the commit returns at once (it blocked
# 24-70 s per src commit, advisory only); the result lands in .git/ratchet-last.txt and a rise types one line into the
# committing pane. A commit that changed none of the ratchet's inputs cannot move it and starts nothing.
if [ -f "$repo/lint/ratchet.mjs" ] && [ -f "$repo/scripts/commit-ratchet.sh" ]; then
  paths="src lint .oxlintrc.ratchet.json package.json .oxlintrc.json scripts/guard-counts.mjs scripts/guard-index-tree.mjs scripts/guard-index-tree.d.mts scripts/legacy-shards.mjs"
  # shellcheck disable=SC2086 # word-split on purpose: a list of literal paths
  if ! { git -C "$repo" rev-parse -q --verify HEAD^ >/dev/null && git -C "$repo" diff --quiet HEAD^ HEAD -- $paths; }; then
    (cd "$repo" && exec python3 -c 'import os, sys; os.setsid(); os.execvp(sys.argv[1], sys.argv[1:])' \
      bash scripts/commit-ratchet.sh "$(git -C "$repo" rev-parse HEAD)" "${HERDR_PANE_ID:-}") \
      < /dev/null > /dev/null 2>&1 &
  fi
fi

exit 0
