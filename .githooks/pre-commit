#!/usr/bin/env bash
# G416: compile/lint the staged source. Build and playable boot run at push/CI.
set -euo pipefail
python3 scripts/commit-message-lock.py "$PPID"
finish() { local rc=$?; python3 scripts/commit-message-lock.py --record "$PPID" "$rc"; exit "$rc"; }
trap finish EXIT
python3 scripts/check-commit-index.py "$PPID"
node scripts/precommit-inputs.mjs
