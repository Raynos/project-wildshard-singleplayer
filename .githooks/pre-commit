#!/usr/bin/env bash
# D9: cheap types/lint on changed files and storage. CI owns complete checks.
set -euo pipefail
[ "${WS_COMMIT_WRAPPER:-}" = 1 ] || { echo 'Use scripts/commit.sh "message" -- <files...>' >&2; exit 1; }
# Storage policy (docs/process/STORAGE.md): the staged objects of this commit's own index (GIT_INDEX_FILE), plus the
# unpushed and rolling-week budgets. Restores the progress-image / .blend / raw-archive guards removed in 819a36b8d.
node scripts/repo-size.mjs --index
node scripts/precommit-inputs.mjs
