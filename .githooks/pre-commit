#!/usr/bin/env bash
# pre-commit: keep pushes small. Every push is one pack over a ~10–100 KB/s uplink shared by every agent (E19), and
# progress/ screenshots were most of it (2–4 MB PNGs). An image added or changed under progress/ must be ≤ 500 KB:
# save JPEG / WebP (`cwebp -q 82 in.png -o out.webp`, `sips -s format jpeg in.png --out out.jpg`). Videos exempt.
# Escape (rare): git commit --no-verify.
set -uo pipefail
# bench-max (2026-10-13, progress/process/bench-max-2026-10-13/): every step prints its time and the hook its total.
now() { if [ -n "${EPOCHREALTIME:-}" ]; then printf '%s' "${EPOCHREALTIME/,/.}"; else date +%s; fi; }
since() { awk -v a="$1" -v b="$(now)" 'BEGIN { printf "%.2f", b - a }'; }
hook_started="$(now)"

# E476: keep Git message handling exclusive until the commit exits.
python3 scripts/commit-message-lock.py "$PPID" || exit $?
trap 'python3 scripts/commit-message-lock.py --record "$PPID" "$?"' EXIT
python3 scripts/check-commit-index.py "$PPID" || exit $?

LIMIT=512000
bad=""
blends=""
while IFS= read -r f; do
  [ -n "$f" ] || continue
  case "$f" in
    *.blend | *.blend[0-9]*) blends="$blends  $f"$'\n'; continue ;;
    progress/*.png | progress/*.jpg | progress/*.jpeg | progress/*.webp) ;;
    *) continue ;;
  esac
  size="$(git cat-file -s ":$f" 2>/dev/null || echo 0)"
  if [ "$size" -gt "$LIMIT" ]; then bad="$bad  $f ($((size / 1024)) KB)"$'\n'; fi
done < <(git diff --cached --name-only --diff-filter=AM)

# a .blend is never committed (M10, E315): the Blender script is the source and its exported GLB is what we commit
if [ -n "$blends" ]; then
  cat >&2 <<EOF
BLOCKED by .githooks/pre-commit: a .blend is never committed. The Blender script is the source; commit the GLB it
exports. Build with scripts/blender/build.sh (--save-blend puts an inspection copy in ~/.cache/wildshard-blender/).
$blends
EOF
  exit 1
fi

# No raw soak / census / receipt archives in git (Jake, 2026-10-09, process audit progress/process/audit-2026-10-09/,
# docs/process/MACHINE.md): 74 MB of .gz / .br soak logs crossed the uplink in 12 h and do not delta. New files only.
raw="$(git diff --cached --name-only --diff-filter=A -- 'progress/*.gz' 'progress/*.br' 'progress/*.zst' 'progress/*.jsonl' | sed 's/^/  /')"
if [ -n "$raw" ]; then
  cat >&2 <<EOF
BLOCKED by .githooks/pre-commit: raw soak / census / receipt archives stay out of git (MACHINE.md). Keep them in your
scratchpad (or a CI artifact) and commit the summary and the numbers (summary.json, a CSV, a board, the verdict line).
$raw
EOF
  exit 1
fi

if [ -n "$bad" ]; then
  cat >&2 <<EOF
BLOCKED by .githooks/pre-commit: progress/ images over 500 KB — every push crawls over a slow shared uplink.
$bad
Save them as JPEG / WebP instead:
    cwebp -q 82 shot.png -o shot.webp
    sips -s format jpeg shot.png --out shot.jpg
EOF
  exit 1
fi
# SF74 W14: the commit holds the shared index.lock for this whole hook, so the independent node checks run side by side
# (each reads the commit's index, none writes it); the hook fails when any of them fails.
# G367: index-reading checks start once the index-writing producer has finished. The architecture guards start with it
# and wait for its status file before they read anything it can stage (scripts/precommit-guards.mjs).
state="$(mktemp -d "${TMPDIR:-/tmp}/wildshard-precommit-hook-XXXXXX")" || exit 1
trap 'hook_rc=$?; rm -rf "$state"; python3 scripts/commit-message-lock.py --record "$PPID" "$hook_rc"' EXIT
step() { # step <name> <command...>: run one check, then print its wall time
  local name="$1" started; started="$(now)"; shift
  "$@"; local rc=$?
  echo "pre-commit step $name: $(since "$started")s" >&2
  return "$rc"
}
# E362 AG20: the commit's temporary/private index, so unrelated agents' WIP never participates.
(export WS_PRECOMMIT_INPUTS_DONE="$state/inputs"; step guards node scripts/precommit-guards.mjs) & guards=$!
step inputs node scripts/precommit-inputs.mjs; echo "$?" > "$state/inputs.tmp"; mv "$state/inputs.tmp" "$state/inputs"
if [ "$(cat "$state/inputs")" != 0 ]; then wait "$guards"; echo "pre-commit: failed in $(since "$hook_started")s" >&2; exit 1; fi
pids=("$guards")
# SF6b: builders land source only; the serialized pusher owns generated measurements and docs.
step generated node scripts/precommit-generated.mjs & pids+=($!)
# G320: newly deleted catalogue outputs require their complete product, never just a component match.
step removals node scripts/precommit-generation-removals.mjs & pids+=($!)
# E362 AG7: increases warn for exact coordinator approval; reach and cycle checks stay fatal.
# shellcheck disable=SC2046 # word-split on purpose: the staged src paths
step graph node scripts/check-graph.mjs --source-only --paths $(git diff --cached --name-only --diff-filter=ACMR -- src) & pids+=($!)
# E423: a staged ask file follows the ask rules (docs/process/ASKS.md: Status vocabulary, folds name a target).
step asks node scripts/asks.mjs check & pids+=($!)
rc=0
for pid in "${pids[@]}"; do wait "$pid" || rc=1; done
echo "pre-commit: $([ "$rc" = 0 ] && echo passed || echo failed) in $(since "$hook_started")s" >&2
exit "$rc"
