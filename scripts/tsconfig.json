{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "types": [
      "node"
    ],
    "lib": [
      "ES2022",
      "DOM"
    ],
    "composite": true,
    "incremental": true,
    "rootDir": "..",
    "tsBuildInfoFile": "../.tsc-layers/scripts.tsbuildinfo"
  },
  "references": [
    {
      "path": "../tsconfig.format.json"
    },
    {
      "path": "../tsconfig.engine.json"
    },
    {
      "path": "../tsconfig.sdk.json"
    }
  ],
  "include": [
    "frame-cost-report.ts",
    "types/*.d.ts",
    "parity.mjs",
    "test-template-gate.mjs",
    "parity/**/*.mjs",
    "gpu-gate/**/*.mjs",
    "deploy-pin.mjs",
    "calibrate.mjs",
    "budget-ceilings.mjs"
  ],
  "files": [
    "section-inventory.ts",
    "bake-loader.mjs",
    "perf/exact-world-capture.mjs",
    "preparation-cache-key.mjs",
    "author-bundle-usage.mjs",
    "generation-cache-prune.mjs",
    "ci-product-cache.mjs"
  ]
}
