{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wildshard:loading-benchmark:1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "loading-benchmark/1"
    },
    "pin": {
      "type": "string"
    },
    "device": {
      "type": "string"
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "shard": {
            "type": "string"
          },
          "cache": {
            "enum": [
              "cold",
              "warm"
            ]
          },
          "timeToPlayableMs": {
            "type": "number",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "phases": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "startMs": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "endMs": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "owner": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "startMs",
                "endMs",
                "owner"
              ],
              "additionalProperties": false
            }
          },
          "longTasks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "startMs": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "durationMs": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "exclusiveMinimum": 50
                },
                "owner": {
                  "type": "string"
                }
              },
              "required": [
                "startMs",
                "durationMs",
                "owner"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "shard",
          "cache",
          "timeToPlayableMs",
          "phases",
          "longTasks"
        ],
        "additionalProperties": false
      }
    },
    "missing": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema",
    "pin",
    "device",
    "runs",
    "missing"
  ],
  "additionalProperties": false
}
