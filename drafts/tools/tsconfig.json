{
  // The drafts tools and tests (node 24, run as .ts with type stripping, so imports carry their .ts extension).
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "lib": ["ES2023", "DOM"],
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true
  },
  "include": [".", "../test", "../vite.config.ts"]
}
