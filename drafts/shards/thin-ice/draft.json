    {
      "id": "PA",
      "question": "Can codex paint a usable semantic layout map from our schematic?",
      "result": "On the fjord spec, 3 of 3 codex variants put 11 / 11 places in their region and kept every path; palette fidelity 94.9–97.9 %; ~110 s each, in parallel.",
      "changed": "T3's gate is places-in-region 100 % + every route on walkable ground; palette fidelity is a warning below 94 %.",
      "items": [
        "round-0-references/layout-b.jpg",
        "round-0-references/layout-c.jpg"
      ]
    },
    {
      "id": "PB1",
      "question": "Does Eq. 6 over a painted map give walkable terrain on the 256² / 500 m grid?",
      "result": "Slab: 84–91 % of land walkable, 77–84 % gentle; the cube drops to 68 % walkable and turns small rock islands into 70 m spikes.",
      "changed": "T3 merges specks under ~600 m²; T4 ramps a high region in from its edge; P8 pads every place (≤ 15°).",
      "items": [
        "round-0-references/terrain-sheet.jpg"
      ]
    },
    {
      "id": "PB2",
      "question": "How much of the 250,000 m² does a player see, and how close?",
      "result": "Close ≤ 30 m: 34–38 %; mid 30–80 m: 32–36 %; far > 80 m: 20–24 %; never seen: 3–9 %, on all four maps.",
      "changed": "Banded polish (later D60: every seen band gets full polish, close first); a route-length budget in the spec.",
      "items": []
    }
  ],
