{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": [
      "vite/client"
    ],
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "composite": true,
    "incremental": true,
    "noEmit": false,
    "rootDir": "..",
    "tsBuildInfoFile": "../.tsc-layers/drafts.tsbuildinfo",
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "../.tsc-layers/drafts",
    "allowImportingTsExtensions": true
  },
  "include": [
    "src"
  ],
  "references": [
    {
      "path": "../tsconfig.game.json"
    }
  ]
}
