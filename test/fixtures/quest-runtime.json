{"content":{"board":{"id":"pine.lodge","rows":[{"goal":"Take 3 deer","id":"contract.species.deer","kind":"species","need":3,"reward":{"bolts":10,"items":[{"id":"lodge-ribbon","n":1}]},"target":"deer","title":"Venison for the lodge"},{"goal":"Take 3 boar","id":"contract.species.boar","kind":"species","need":3,"reward":{"bolts":10,"items":[{"id":"lodge-ribbon","n":1}]},"target":"boar","title":"The rooting boar"},{"goal":"Take 2 elk","id":"contract.species.elk","kind":"species","need":2,"reward":{"bolts":10,"items":[{"id":"lodge-ribbon","n":1}]},"target":"elk","title":"Elk for the smokehouse"},{"goal":"Take 1 bear","id":"contract.species.bear","kind":"species","need":1,"reward":{"bolts":10,"items":[{"id":"lodge-ribbon","n":1}]},"target":"bear","title":"A bear too bold"},{"goal":"Take 2 uncommon animals","id":"contract.rarity.uncommon","kind":"rarity","need":2,"reward":{"bolts":0,"items":[{"id":"lodge-ribbon","n":2}]},"target":"uncommon","title":"Something unusual"},{"goal":"Take a rare animal","id":"contract.rarity.rare","kind":"rarity","need":1,"reward":{"bolts":0,"items":[{"id":"lodge-ribbon","n":2}]},"target":"rare","title":"A rare coat"},{"goal":"Take Old Ironhide","id":"contract.elite.ironhide","kind":"elite","need":1,"reward":{"bolts":0,"items":[{"id":"lodge-ribbon","n":3},{"id":"amber-resin","n":4}]},"target":"ironhide","title":"A name on the board"},{"goal":"Take the Ghost Stag","id":"contract.elite.ghost-stag","kind":"elite","need":1,"reward":{"bolts":0,"items":[{"id":"lodge-ribbon","n":3},{"id":"amber-resin","n":4}]},"target":"ghost-stag","title":"A name on the board"},{"goal":"Take Old Blackpaw","id":"contract.elite.blackpaw","kind":"elite","need":1,"reward":{"bolts":0,"items":[{"id":"lodge-ribbon","n":3},{"id":"amber-resin","n":4}]},"target":"blackpaw","title":"A name on the board"},{"goal":"Take the Imperial Bull","id":"contract.elite.imperial-bull","kind":"elite","need":1,"reward":{"bolts":0,"items":[{"id":"lodge-ribbon","n":3},{"id":"amber-resin","n":4}]},"target":"imperial-bull","title":"A name on the board"},{"goal":"Put down 3 thralls","id":"contract.thrall.thrall","kind":"thrall","need":3,"reward":{"bolts":0,"items":[{"id":"lodge-ribbon","n":2},{"id":"amber-resin","n":3}]},"target":"thrall","title":"Cull the moss-grown"}]},"chapters":[{"completeFlag":"quest:warden-done","id":"wardens-hollow","intro":{"chip":"Find the ranger","hint":"Up the south road to the crossroads, then east","markers":[{"at":{"poi":"world","x":-4,"z":-38},"id":"ranger","label":"RANGER'S CABIN","short":"RANGER"}],"objective":"Find the ranger at his cabin in the Hollow"},"startWhen":{"all":["talked:ranger"]},"steps":[{"chip":"The pond lantern","done":{"all":["lit:pond"]},"hint":"Its glass is in the beaver pool — drain the pool at the dam, then light the waystone on the W shore","id":"pond","markers":[{"at":{"poi":"world","x":-138,"z":64},"hideWhen":{"all":["taken:pond-glass"]},"id":"dam","label":"BEAVER DAM","short":"BEAVER DAM"},{"at":{"poi":"world","x":-63,"z":104},"hideWhen":{"none":["taken:pond-glass"]},"id":"pond-lantern","label":"POND LANTERN","short":"POND LANTERN"}],"objective":"Relight the pond lantern"},{"chip":"The ridge lantern","done":{"all":["lit:ridge"]},"hint":"Climb the fire lookout; the fire-watcher's flint is on the fire finder in the cab","id":"ridge","markers":[{"at":{"poi":"world","x":36,"z":214},"id":"lookout","label":"FIRE LOOKOUT","short":"FIRE LOOKOUT"}],"objective":"Relight the ridge lantern"},{"chip":"Ride the zipline","done":{"all":["used:ph-zip"]},"hint":"The launch is off the lookout deck, on the Hollow side","id":"zip","markers":[{"at":{"poi":"world","x":35,"z":206},"id":"launch","label":"ZIPLINE","short":"ZIPLINE"}],"objective":"Ride the zipline back to the Hollow"},{"chip":"The den lantern","done":{"all":["lit:den"]},"hint":"At the bear cave's mouth, in the north-west. Old Blackpaw sleeps light","id":"den","markers":[{"at":{"poi":"world","x":196,"z":196},"id":"den","label":"BEAR CAVE","short":"BEAR CAVE"}],"objective":"Relight the den lantern"},{"chip":"Follow the stag","done":{"all":["followed:stag"]},"hint":"It walks the west road at night — Hale will wait with you till dark","id":"stag","markers":[{"at":{"poi":"world","x":30,"z":-2},"id":"stag","label":"THE WEST ROAD","short":"WEST ROAD"}],"objective":"Follow the Ghost Stag after dark"},{"chip":"The Antler King","done":{"all":["dead:king"]},"hint":"In the clearing of standing stones, at night","id":"king","markers":[{"at":{"poi":"world","x":150,"z":-30},"id":"clearing","label":"KING'S CLEARING","short":"THE CLEARING"}],"objective":"Face the Antler King"},{"chip":"Dawn","done":{"all":["seen:dawn"]},"hint":"Watch the east","id":"dawn","objective":"Dawn over the Hollow"}],"title":"The Warden's Hollow"}],"id":"pine.quest","npcs":[{"dialogue":[{"lines":["Dawn, and every lantern burning. I have not seen the Hollow this quiet in thirty winters.","The old Warden kept a bow for a night like that one. It is yours now. He would want it used, not hung on a wall."],"when":{"all":["quest:warden-done"]}},{"lines":["It is over? Then watch the east. Dawn comes to the Hollow the way it used to."],"when":{"all":["dead:king"]}},{"lines":["The stag took you to the stones. He is there — only at night, and only if you stand inside the ring.","Mind his antlers when they swing, and jump his roots. When the fog closes behind you, it will not open until one of you falls."],"when":{"all":["followed:stag"]}},{"lines":["Three lanterns. I watched them come up one by one from this porch.","Now the pale stag will walk. Follow it after dark down the west road and it will take you to him.","If you would rather not wait for the dark on your own, sit a while. I will keep watch with you."],"sets":["wait:night"],"when":{"all":["lit:pond","lit:ridge","lit:den","used:ph-zip"]}},{"lines":["You came down the line — I heard you from here. The last lantern is at the bear cave, in the north-west corner.","Old Blackpaw sleeps in the mouth of it. He sleeps light."],"when":{"all":["lit:pond","lit:ridge","used:ph-zip"]}},{"lines":["The ridge lantern is burning. Now take the line down off the deck — it is faster than the trail, and louder."],"when":{"all":["lit:pond","lit:ridge"]}},{"lines":["The pond is lit. Next, the ridge: climb the fire lookout on the pass.","The fire-watcher kept her flint on the fire finder in the cab. Light the waystone at the foot of the stair, then take the zipline home."],"when":{"all":["lit:pond"]}},{"lines":["The pond lantern's glass went into the beaver pool behind the dam, north-east of here.","Heave the two logs off the dam's sluice and the pool will drain through it. The glass will wash out below."],"when":{"all":["talked:ranger"]}},{"lines":["Easy. You are not one of them. Good. Not many come up the south road any more.","I am Hale. I keep the lanterns in the Hollow. Kept. Three waystones: the pond, the ridge, the den. They went dark the night the fog came up out of the old-growth.","Since then something walks the big trees after dark. Antlers of light. The elk and the boar that wander in there come out wrong: moss on them, glass for eyes.","Light the lanterns again and we will see what is what. Start at the pond. Its glass is in the beaver pool, under the dam."],"sets":["talked:ranger"]}],"id":"ranger","name":"Hale, ranger of the Hollow"},{"dialogue":[{"lines":["Hear that? The wheel is singing. Come by for bread when the fog lifts for good."],"when":{"all":["errand:thanked"]}},{"lines":["You cleared the race. The wheel turned the moment the last of them went down. First time since the fog.","The lodge pays in ribbons and I have a drawer full of them. Take these, and the resin I scraped off the sluice boards."],"sets":["errand:thanked"],"when":{"all":["errand:done"]}},{"lines":["They come up the millrace after dark and stand in the water, like they are listening for something.","The wheel will not turn with them in it. Clear the race after nightfall and it will."],"when":{"all":["errand:asked"]}},{"lines":["You carry a bow. Good. Something has jammed my wheel, and it is not a branch.","It is them. The mossy ones. They stand in the millrace at night and the wheel will not turn with them in it.","Clear the race after dark, would you? I will make it worth the walk."],"sets":["errand:asked"]}],"id":"miller","name":"Brandt, the miller"},{"dialogue":[{"lines":["Hides, horn, resin. Let us see what you have."],"when":{"all":["talked:trader"]}},{"lines":["No coin, no credit, no questions. I swap. Hides, horn, the amber the old pines weep: I take it all.","Bolts for your bow, and a finish or two for the particular. Let us see what you have."],"sets":["talked:trader"]}],"id":"trader","name":"Mott, the trader"}],"trader":{"id":"pine.mott","rows":[{"blurb":"Fletched with goose, straight as a promise","get":{"bolts":10},"give":[{"item":"deer-hide","n":2}],"id":"bolts-hide","label":"A quiver of bolts ×10","short":"Bolts"},{"blurb":"Resin-sealed heads, they fly true in the rain","get":{"ammo":"pitch","n":10},"give":[{"item":"amber-resin","n":3}],"id":"pitch-bolts","label":"Pitch-tipped bolts ×10","short":"Pitch bolts"},{"blurb":"Wide steel heads, they cut deep in deer and boar","get":{"ammo":"broadhead","n":8},"give":[{"item":"boar-hide","n":1},{"item":"amber-resin","n":2}],"id":"broadheads","label":"Broadhead bolts ×8","short":"Broadheads"},{"blurb":".30-30, a waxed-paper box of Mott's own","get":{"ammo":"cartridge","n":14},"give":[{"item":"venison","n":2},{"item":"amber-resin","n":1}],"id":"cartridges","label":"Rifle cartridges ×14","short":"Cartridges"},{"blurb":"Ash shafts, for a longbow, if you have one","get":{"ammo":"arrow","n":10},"give":[{"item":"deer-hide","n":1},{"item":"amber-resin","n":1}],"id":"arrows","label":"Goose-fletched arrows ×10","short":"Arrows"},{"blurb":"Charred ash, cold light in the cracks","get":{"skin":"hollow-ash"},"give":[{"item":"bear-pelt","n":1},{"item":"amber-resin","n":6}],"id":"hollow-ash","label":"Hollow Ash crossbow finish","once":