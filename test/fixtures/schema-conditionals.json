{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "mode": {
      "enum": [
        "strict",
        "loose"
      ]
    },
    "trigger": {
      "type": "boolean"
    },
    "count": {
      "type": "integer"
    },
    "options": {
      "type": "array",
      "items": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        }
      ],
      "additionalItems": false
    },
    "values": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "contains": {
        "minimum": 1
      }
    }
  },
  "additionalProperties": false,
  "propertyNames": {
    "pattern": "^[a-z]+$"
  },
  "dependencies": {
    "trigger": [
      "count"
    ]
  },
  "required": [
    "mode"
  ],
  "if": {
    "properties": {
      "mode": {
        "const": "strict"
      }
    },
    "required": [
      "mode"
    ]
  },
  "then": {
    "required": [
      "options"
    ]
  },
  "else": {
    "not": {
      "required": [
        "options"
      ]
    }
  }
}
