   const pins = window.__wildshardHarness, saves = pins?.saves ?? { read: [], written: [] };
+  // F3n proof: upload and retain 1 MiB every 10 seconds. Never shipped unplanted.
+  const soakLeaks: THREE.DataTexture[] = [];
+  let soakLeakSeconds = 0;
+  world.game.onUpdate((dt) => {
+    soakLeakSeconds += dt;
+    if (soakLeakSeconds < 10) return;
+    soakLeakSeconds -= 10;
+    const texture = new THREE.DataTexture(new Uint8Array(512 * 512 * 4), 512, 512);
+    texture.needsUpdate = true;
+    world.game.renderer.initTexture(texture);
+    soakLeaks.push(texture);
+  }, 'soak-leak');
   const hits: { kind: string; amount: number }[] = [], kills: string[] = [], labels: string[] = [];
   let events: Record<string, number> = {}; const ambient = new Set<string>();
