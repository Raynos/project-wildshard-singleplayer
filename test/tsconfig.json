{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "incremental": true,
    "noEmit": true,
    "rootDir": "..",
    "tsBuildInfoFile": "../.tsc-layers/root-tests.tsbuildinfo"
  },
  "references": [
    {
      "path": "../tsconfig.format.json"
