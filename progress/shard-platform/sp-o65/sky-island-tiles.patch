+/**
+ * The runtime-bound props (G227): a hybrid whose shardfile declares `runtime.binds: ['props']` ships its static props as the
+ * compiled props tiles, and its trusted runtime draws them in its own materials. Each tile's GLB is parsed here and handed to
+ * the runtime's `props` view, which puts its own materials on the meshes; the parsed geometry (and any GLB material the view
+ * kept) is freed with the tile. With coarse (L1) tiles the tiles stream through the terrain's residency (`clientWorld`: the
+ * coarse tiles resident and masked where a fine tile is, fine tiles inside the shared disc); a section of fine tiles only
+ * (whole shapes, `bakeProps` `whole`, which no coarse tile stands in for) keeps every tile resident: a small world seen whole.
+ */
+export interface RuntimePropsPorts {
+  readonly assets: ClientAssets;
+  /** The runtime's view of one parsed tile (`key` `<lod>/<x>/<z>`): put `tile` under `scope` in its own materials. */
+  readonly props: (tile: Object3D, key: string, scope: Scope) => ResidentTile;
+  readonly x: number;
+  readonly z: number;
+  readonly residency?: { allocator: ResidencyAllocator; owner: string };
+}
+/** The bound props: move the residency disc (shard-local metres); resolves when the fine tiles there are resident. */
+export interface RuntimeProps { readonly refresh: (x: number, z: number) => Promise<void>; readonly fine: ReadonlySet<string> }
+
+const isMesh = (o: Object3D): o is Mesh => o instanceof Mesh;
+/** Bind a runtime's declared props tiles under `scope`; throws unless the section is bound. Library models and panels are not runtime-bound yet. */
+export async function bindRuntimeProps(ctx: { readonly scope: Scope }, source: Shardfile, ports: RuntimePropsPorts): Promise<RuntimeProps> {
+  if (source.runtime === null) throw new Error('Runtime-bound props need a trusted runtime declaration');
+  if (!runtimeBinds(source).has('props')) throw new Error('Shardfile props are not bound by its runtime (runtime.binds)');
+  const props = source.props; if (props === null || props.tiles.length === 0) throw new Error('Runtime-bound props declare no props tiles');
+  if (props.panels.length + props.models.length + props.textures.length > 0) throw new Error('Runtime-bound props carry tiles only');
+  const view = async (key: string, bytes: Uint8Array, scope: Scope): Promise<ResidentTile> => {
+    const gltf = await new GLTFLoader().parseAsync(bytes.slice().buffer, ''), meshes: Mesh[] = [];
+    gltf.scene.traverse((o) => { if (isMesh(o)) meshes.push(o); });
+    // a GLB material the runtime's view replaced is freed at once; one it kept lives with the tile
+    const materials = (): Set<Material> => new Set(meshes.flatMap((mesh): Material[] => Array.isArray(mesh.material) ? mesh.material : [mesh.material]));
+    const originals = materials(), free = (kept: ReadonlySet<Material>): void => { for (const mesh of meshes) mesh.geometry.dispose(); for (const m of kept) m.dispose(); };
+    if (scope.disposed) { free(originals); throw new Error('Prop tile unloaded while parsing'); }
+    const tile = ports.props(gltf.scene, key, scope), used = materials(), kept = new Set([...originals].filter((m) => used.has(m)));
+    for (const m of originals) if (!kept.has(m)) m.dispose();
+    scope.onDispose(() => { gltf.scene.removeFromParent(); free(kept); });
+    return tile;
+  };
+  if (props.tiles.some((tile) => tile.lod === 1)) {
+    const world = await clientWorld({ ...source, terrain: null }, ports.assets, { scope: ctx.scope, x: ports.x, z: ports.z, views: {
+      terrain: () => { throw new Error('Runtime-bound props have no terrain view'); },
+      library: () => Promise.resolve({ tiles: new Map(), panels: new Map(), models: new Map(), far: null, disposeTile: () => undefined }),
+      props: (_props, key, bytes, scope) => view(key, bytes, scope),
+    }, ...(ports.residency === undefined ? {} : { residency: ports.residency }) });
+    return { refresh: world.refresh, get fine() { return world.fine; } };
+  }
+  const fine = new Set<string>(), lifetime = ctx.scope.child('runtime-props');
+  try {
+    for (const row of props.tiles) {
+      const key = `${row.lod}/${row.x}/${row.z}`, scope = lifetime.child(key), cost = source.tiles.find((tile) => tile.lod === row.lod && tile.x === row.x && tile.z === row.z);
+      if (cost === undefined) throw new Error(`Missing admitted props tile cost ${key}`);
+      if (ports.residency !== undefined) {
+        const lease = ports.residency.allocator.reserve({ id: `${ports.residency.owner}:l0/${row.x}/${row.z}`, category: 'l0', owner: ports.residency.owner, bytes: cost.decoded + cost.gpu, distance: 0, needed: true });
+        if (lease === null) throw new Error(`Runtime props tile ${key} residency admission deferred`);
+        scope.onDispose(() => { lease.release(); });
+      }
+      scope.onDispose(ports.assets.lease([row.file]));
+      const bytes = await ports.assets.read(row.file); if (scope.disposed) throw new Error('Runtime props unloaded while reading');
+      await view(key, bytes, scope); fine.add(key);
+    }
+    ports.assets.releaseTiles();
+  } catch (error) { lifetime.dispose(); throw error; }
+  return { refresh: () => Promise.resolve(), fine };
+}
