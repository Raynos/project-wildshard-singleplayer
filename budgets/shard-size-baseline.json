{
 "schema": 1,
 "about": "What each shard downloaded before DOWNLOAD began, and what a build may ship. scripts/shard-size-gate.mjs reads this on every web build. Plan: docs/plans/multi-repo/SHARD-SIZE-PLAN.md in project-wildshard-meta.",
 "baseline": {
  "commit": "1474f7deb9cb190cab32bc8a3388c2adefc119ef",
  "committed": "2026-10-29T14:41:01-05:00",
  "why": "The last commit with exactly Sky Reach and Signal Dunes retired (G882, G883): SHARD-PLATFORM at 2 of 6, one commit before Driftwood's legacy went (019fa6d0c7).",
  "measured": "2026-11-05"
 },
 "recorded": {
  "commit": "38852e26e0b7469326e6014939330f945b981021",
  "measured": "2026-11-06"
 },
 "units": {
  "baselinePhoneBytes": "Real bytes on the socket for one cold entry at the baseline commit: title plus entry, from a fresh profile.",
  "recordedPhoneBytes": "The packs book at the recorded commit: client.<slug>.phone.wireBytes. This is what the gate compares.",
  "comparable": "The two units track each other when no read-ahead is running. Neither counts the title read-ahead of another shard; recorded.phone.titleBytes shows it, and it depends on how long the player stays on the title.",
  "thinTarball": "A thin head as the api holds it (measured 2026-11-06 from ~/.cache/wildshard/pins): no blobs/pack, and mounts/assets holds unique bytes, 0.2 MB of Pine's 167.2 repeating a blob."
 },
 "method": {
  "network": "scripts/shard-wire-meter.mjs: a counting proxy between a fresh Chromium profile and scripts/preview-server.mjs, one entry through SHARD SELECT, Hold at loading screen on, stopped after 12 s of network silence.",
  "caveat": "Unthrottled localhost, so the title read-ahead runs further than on a real link: production Pine phone measured 122.0 MB where this meter measured 129-132 MB. Compare entryBytes across builds, not titleBytes.",
  "steps": [
   "git worktree add --detach tmp/size-baseline/old 1474f7deb9cb190cab32bc8a3388c2adefc119ef",
   "cd tmp/size-baseline/old && pnpm install --frozen-lockfile --config.confirmModulesPurge=false",
   "export WILDSHARD_SHARDFILE_CACHE=<a folder outside this repo>; a sibling of the checkout makes the product input trace refuse the path ..",
   "pnpm gen --inputs-only && node scripts/build-shardfiles.mjs --reuse && node scripts/build-app.mjs",
   "Skip the build script's tsc step: it fails on three types in this checkout and emits nothing that ships.",
   "From a current checkout, per shard and tier: node scripts/shard-wire-meter.mjs --root <the worktree> --shard <slug> --tier <tier> --out <file>",
   "node scripts/shard-size-gate.mjs --folders <the worktree>",
   "git worktree remove tmp/size-baseline/old && git worktree prune"
  ]
 },
 "limits": {
  "newShardHardCapBytes": 60000000,
  "targetPhoneBytes": [
   30000000,
   40000000
  ],
  "targetSource": "Estimate: docs/plans/multi-repo/research/cooking-and-packs.md. The target is printed in the plan and refuses nothing.",
  "toleranceBytes": 256000,
  "ratchetSlackBytes": 1000000
 },
 "update": {
  "shrink": "After a change saves bytes: node scripts/shard-size-gate.mjs dist --ratchet, and commit this file with the change. The build refuses a shrink-only shard more than 1 MB under its ceiling until this is done. A shrink-only ceiling follows the shard down past its baseline (latchedPhoneBytes), so it can't regrow into the old room.",
  "grow": "Only on Jake's word: set ceilingPhoneBytes and add {shard, toBytes, decision, why} to raises, naming his G or E number. A raised ceiling with no such row is refused.",
  "remeasure": "To change the baseline itself, redo method.steps from baseline.commit, or move baseline.commit on Jake's word and redo them there."
 },
