{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "outDir": ".tsc-layers/sdk",
    "tsBuildInfoFile": ".tsc-layers/sdk.tsbuildinfo"
  },
  "references": [
    {
      "path": "./tsconfig.engine.json"
    },
    {
      "path": "./tsconfig.game.json"
    }
  ],
  "include": [
    "src/sdk/**/*.ts",
    "src/engine/**/*.d.ts",
    "src/game/**/*.merge.d.ts"
  ]
}
