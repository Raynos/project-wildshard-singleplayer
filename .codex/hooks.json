{
  "description": "Wildshard's shared-tree guardrails and session brief for Codex.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/session-brief.sh\"",
            "statusMessage": "Reading open asks and live plans",
            "additionalContextLimit": 6000
          },
          {
            "type": "command",
            "command": "nohup bash \"$(git rev-parse --show-toplevel)/scripts/browser-lane.sh\" reap >/dev/null 2>&1 &"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/guard-bash-safety.sh\"",
            "statusMessage": "Checking shared-tree safety"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/guard-browser-lane.sh\"",
            "statusMessage": "Checking the browser lane"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/guard-polling.sh\"",
            "statusMessage": "Checking for polling loops"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/guard-herdr-prompt.sh\"",
            "statusMessage": "Checking herdr prompt targets"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "nohup bash \"$(git rev-parse --show-toplevel)/scripts/browser-lane.sh\" reap >/dev/null 2>&1 &"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "nohup bash \"$(git rev-parse --show-toplevel)/scripts/browser-lane.sh\" reap >/dev/null 2>&1 &"
          }
        ]
      }
    ]
  }
}
