{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": [
      "vite/client"
    ],
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "composite": true,
    "incremental": true,
    "noEmit": false,
    "rootDir": "..",
    "tsBuildInfoFile": "../.tsc-layers/admin.tsbuildinfo",
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "../.tsc-layers/admin"
  },
  "include": [
    "src"
  ]
}
